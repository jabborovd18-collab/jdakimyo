// ═══════════════════════════════════════════════════════════════
// O'QITUVCHI PANELI
// ═══════════════════════════════════════════════════════════════

// Email tasdiqlash kodi.
//
// Kod HAVOLA emas, olti xonali raqam: pochta mijozlari havolani ba'zan
// buzadi yoki oldindan bosib qo'yadi, raqamni esa odam telefondan
// ko'chirib yozaveradi.
//
// `urinish` — noto'g'ri kiritishlar soni. Chegarasiz bo'lsa, olti
// xonali kodni yuz mingta so'rov bilan topib olish mumkin edi.
model EmailTasdiq {
  id         String   @id @default(cuid())
  userId     String   @unique
  kod        String
  urinish    Int      @default(0)
  amalQiladi DateTime
  yuborilgan DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([amalQiladi])
}

// IP bo'yicha tezlik cheklovi (lib/ip-cheklov.js).
//
// NEGA BAZADA, XOTIRADA EMAS. Vercel funksiyalari serverless: ketma-ket
// kelgan ikki so'rov boshqa-boshqa nusxada bajarilishi mumkin va nusxalar
// xotirani bo'lishmaydi. Xotiradagi Map birinchi nusxada 5 ni sanaydi,
// ikkinchisida yana noldan boshlaydi — ya'ni cheklov faqat qog'ozda
// qolardi.
//
// `kalit` — "amal:oyna:ip" ko'rinishida (masalan `royxat:soat:1.2.3.4`).
// Bitta jadval hamma amalni saqlaydi: qoidalar bir xil, faqat raqamlar
// farq qiladi.
model SorovLimit {
  id         String   @id @default(cuid())
  kalit      String   @unique
  soni       Int      @default(0)
  // Joriy oyna qachon boshlangan. Oyna muddati o'tsa sanoq noldan
  // boshlanadi — shuning uchun alohida "tozalash" mantiqi kerak emas.
  oynaBoshi  DateTime @default(now())
  yangilandi DateTime @updatedAt

  // Eski yozuvlarni tozalash shu indeks orqali ketadi
  @@index([yangilandi])
}

// JDA Kimyo AI ning faol boshqaruv sozlamasi. API kalitlari bu yerga
// yozilmaydi: ular Vercel maxfiy muhitida qoladi, bu jadval faqat routing,
// vaqt, kvota va xavfsiz ishlash siyosatini saqlaydi.
model AiSettings {
  id          String   @id @default("main")
  revision    Int      @default(0)
  config      Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("ai_settings")
}

// Har nashr alohida saqlanadi: noto'g'ri sozlama productionga chiqsa,
// oldingi holatni taxmin qilmasdan aynan o'sha nusxaga qaytish mumkin.
model AiConfigVersion {
  id        String   @id @default(cuid())
  revision  Int      @unique
  config    Json
  note      String?  @db.Text
  adminId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ai_config_versions")
}

// Xom savol va chat matni ataylab saqlanmaydi. Operatsion nazorat uchun
// provayder, vaqt, token va xato kodi yetadi; bu foydalanuvchi maxfiyligini
// buzmasdan haqiqiy AI oqimini o'lchash imkonini beradi.
model AiUsageEvent {
  id                String   @id @default(cuid())
  requestId         String
  channel           String
  operation         String
  direction         String?
  problemType       String?
  provider          String?
  model             String?
  status            String
  errorCode         String?
  durationMs        Int      @default(0)
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  totalTokens       Int      @default(0)
  cacheHit          Boolean  @default(false)
  deterministicUsed Boolean  @default(false)
  fallbackIndex     Int?
  createdAt         DateTime @default(now())

  @@index([requestId])
  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@index([channel, createdAt])
  @@map("ai_usage_events")
}

// Sifat sinovi natijasining ixcham hisoboti. Nazorat savollarining o'zi
// server kodida turadi, shu jadval esa qaysi versiya nechta testdan
// o'tganini audit uchun saqlaydi.
model AiEvalRun {
  id         String   @id @default(cuid())
  adminId    String?
  revision   Int
  totalCases Int
  passed     Int
  failed     Int
  durationMs Int
  details    Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([revision])
  @@map("ai_eval_runs")
}

// Telegram hisobi bilan bog'lanish.
//
// NEGA `chatId` HAM UNIQUE. Bitta Telegram hisobi bitta saytdagi
// hisobga bog'lanadi. Aks holda bir odam o'nta sayt hisobini bitta
// Telegramga ulab, hammasining bildirishnomasini bir joyda kuzatib,
// ko'p akkaunt bilan ishlashni qulaylashtirib olardi.
//
// NEGA `xabarlar` BAYROG'I. Telegram — shaxsiy makon. Odam ulanishni
// saqlab qolib, lekin xabar oqimini o'chirib qo'ya olishi kerak;
// buning uchun butun bog'lanishni uzishga majburlash qo'pol.
model TelegramUlanish {
  id       String   @id @default(cuid())
  userId   String   @unique
  chatId   String   @unique
  // Telegramdagi @nomi — faqat ko'rsatish uchun, o'zgarishi mumkin
  username String?
  xabarlar Boolean  @default(true)
  bogladi  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Bog'lash kodi — saytda yaratiladi, botga yuboriladi.
//
// NEGA KOD KERAK. Telegram botga faqat `chatId` keladi; bot o'zi bu
// odam saytdagi kim ekanini bila olmaydi. Kod — ikkalasini bog'laydigan
// yagona ip. Qisqa muddatli, chunki u aslida bir martalik parol:
// birov kodni ko'rib qolsa, o'z Telegramini begona hisobga ulardi.
model TelegramKod {
  id         String   @id @default(cuid())
  userId     String   @unique
  kod        String   @unique
  amalQiladi DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([amalQiladi])
}

// TESKARI YO'NALISHDAGI kod — botda yaratiladi, saytga kiritiladi.
//
// NEGA IKKINCHI USUL KERAK. Birinchi usulda odam avval saytga kirib,
// sozlamalarni topib, kod olishi kerak edi. Amalda odam botni oldin
// topadi (Telegram doim ochiq turadi) va o'sha yerdan boshlashni
// xohlaydi. Endi bot kod beradi, odam uni sozlamalarga kiritadi —
// yoki bot bergan havolani bosadi va hech narsa terilmaydi.
//
// NEGA `TelegramKod` DAN ALOHIDA. U yerda kalit `userId`: kod
// yaratilganda saytdagi odam kimligi ma'lum. Bu yerda esa aksincha —
// faqat `chatId` ma'lum, foydalanuvchi hali noma'lum.
//
// NEGA IKKI DAQIQA. Kod chat tarixida qolib ketadi. Uzoq yashasa,
// birovning telefonini bir lahzaga olgan odam keyin ham ishlatib
// qolardi.
// Bot qo'shilgan Telegram GURUHLARI.
//
// NEGA KERAK. Bot shaxsiy suhbatda ishlaydi, lekin kunlik iqtibos
// guruhda ma'noliroq: bitta gap butun sinfga ko'rinadi. Guruh
// chatId sini eslab qolmasak, unga hech narsa yubora olmaymiz —
// Telegram bizga guruhlar ro'yxatini bermaydi.
//
// Yozuv bot guruhga QO'SHILGANDA o'zi paydo bo'ladi (`my_chat_member`)
// va bot chiqarilganda `faol: false` bo'ladi. O'chirilmaydi: bot
// qayta qo'shilsa, sozlama saqlanib qolgani yaxshi.
model TelegramGuruh {
  id          String   @id @default(cuid())
  chatId      String   @unique
  nom         String?
  // Kim qo'shgani — admin panelda ko'rinadi
  qoshgan     String?
  // Bu guruhga kunlik iqtibos yuborilsinmi
  iqtiboslar  Boolean  @default(true)
  // JDA KIMYO NEWS kanalidagi xabarlar shu guruhga uzatilsinmi
  yangiliklar Boolean  @default(true)
  faol        Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([faol, iqtiboslar])
  @@index([faol, yangiliklar])
}

model TelegramBotKod {
  id         String   @id @default(cuid())
  chatId     String   @unique
  kod        String   @unique
  // Telegramdagi @nomi — ulanish yaratilganda ko'chiriladi
  username   String?
  // Noto'g'ri urinishlar. Kod qisqa, ya'ni taxmin qilishga urinish
  // mumkin — beshtadan keyin kod kuyadi.
  urinish    Int      @default(0)
  amalQiladi DateTime
  createdAt  DateTime @default(now())

  @@index([amalQiladi])
}

// Elektron doskaga QR orqali kirish.
//
// NEGA KERAK. Ma'ruza zalida o'qituvchi 100 talaba oldida parol tera
// olmaydi. Doskada QR chiqadi, o'qituvchi uni telefonidan skanerlaydi
// va telefonda tasdiqlaydi — parol umuman terilmaydi.
//
// NEGA TELEFONDA TASDIQLASH SHART. QR ni zaldagi har kim skanerlashi
// mumkin. Tasdiqlash bo'lmasa, birinchi skanerlagan odam o'qituvchi
// hisobiga kirib olardi.
//
// Qiymatlar: kutilmoqda | tasdiqlangan | ishlatilgan | bekor
model DoskaSessiya {
  id         String    @id @default(cuid())
  // QR ichidagi maxfiy qiymat
  token      String    @unique
  holat      String    @default("kutilmoqda")
  // Tasdiqlagandan keyin to'ladi
  userId     String?
  // Doska sessiyasi qachon tugaydi (o'qituvchi tanlaydi)
  tugaydi    DateTime?
  // QR ning o'zi tez eskiradi — skanerlashga berilgan vaqt
  amalQiladi DateTime
  // Kim so'rayotgani telefonda ko'rsatiladi
  qurilma    String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User? @relation("DoskaFoydalanuvchi", fields: [userId], references: [id], onDelete: Cascade)

  @@index([holat, amalQiladi])
}

// Do'stlar orasidagi kunlik sovg'a.
//
// Yozuvning o'zi JURNAL: sovg'a qilish qo'shilishidan oldin kelishilgan
// shart shu edi — kim kimga, qachon yuborgani ko'rinib tursin, aks holda
// ko'p akkaunt bilan tanga yig'ishni aniqlab bo'lmasdi.
//
// `kun` — TOSHKENT kuni (UTC+5). Sovg'a shu kun tugashi bilan kuyadi,
// shuning uchun chegara foydalanuvchi yashaydigan vaqt mintaqasida
// bo'lishi kerak: UTC bo'lsa, kechqurun yuborilgan sovg'a odam uxlab
// turgan payt emas, kunduzi kuyib ketardi.
//
// `@@unique([senderId, kun])` — bitta akkaunt kuniga bitta sovg'a
// yuboradi. Cheklovni bazaning o'zi ushlaydi: kodda tekshirsak, ikkita
// so'rov bir vaqtda kelganda ikkalasi ham o'tib ketishi mumkin edi.
// Qabul qiluvchida bunday cheklov yo'q — unga bir necha sovg'a kelaveradi.
model Gift {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  // kutilmoqda | qabul | kuygan
  holat      String    @default("kutilmoqda")
  kun        DateTime  @db.Date
  createdAt  DateTime  @default(now())
  javobVaqt  DateTime?

  sender   User @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, kun])
  @@index([receiverId, holat])
  @@index([kun, holat])
}

model TeacherStudent {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  groupId   String?
  joinedAt  DateTime @default(now())

  // ─── Rozilik ───
  // Avval ustoz istalgan odamni jimgina o'z guruhiga qo'sha olardi:
  // talaba o'zining kimningdir ro'yxatida turganini, unga vazifa
  // berilishini va natijalari ko'rinishini bilmasdi ham.
  //
  // Endi qo'shish TAKLIF: 'sorov' holatida boshlanadi va talaba qabul
  // qilmaguncha guruh a'zosi hisoblanmaydi. Rad etilgani o'chirilmaydi —
  // aks holda ustoz taklifni cheksiz qayta yuboraverardi.
  //
  // Qiymatlar: 'sorov' | 'faol' | 'rad'
  holat     String    @default("sorov")
  javobVaqt DateTime?

  teacher User          @relation("TeacherStudents", fields: [teacherId], references: [id])
  student User          @relation("StudentTeachers", fields: [studentId], references: [id])
  group   TeacherGroup? @relation(fields: [groupId], references: [id])

  @@unique([teacherId, studentId, groupId])
  @@index([studentId, holat])
  @@index([teacherId, holat])
}

model TeacherGroup {
  id          String   @id @default(cuid())
  teacherId   String
  name        String
  description String?
  color       String   @default("blue")
  createdAt   DateTime @default(now())

  teacher       User             @relation(fields: [teacherId], references: [id])
  students      TeacherStudent[]
  assignments   Assignment[]
  announcements Announcement[]
  quizzes       TeacherQuiz[]
  closedQuizzes ClosedQuiz[]
}

model Assignment {
  id                  String    @id @default(cuid())
  teacherId           String
  groupId             String
  title               String
  description         String    @db.Text
  type                String
  deadline            DateTime
  timeLimit           Int?
  startDate           DateTime?
  maxScore            Int       @default(100)
  passingScore        Int?
  gradingCriteria     Json?
  maxAttempts         Int       @default(1)
  allowLateSubmission Boolean   @default(false)
  latePenalty         Float     @default(10)
  instructions        String?   @db.Text
  attachments         Json?
  hints               Json?
  resources           Json?
  isDraft             Boolean   @default(false)
  visibility          String    @default("group")
  requireFile         Boolean   @default(false)
  allowedFileTypes    String?
  maxFileSize         Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  teacher     User                   @relation(fields: [teacherId], references: [id])
  group       TeacherGroup           @relation(fields: [groupId], references: [id])
  submissions AssignmentSubmission[]

  @@index([teacherId])
  @@index([groupId])
  @@index([deadline])
  @@index([isDraft])
  @@index([type])
}

model AssignmentSubmission {
  id            String    @id @default(cuid())
  assignmentId  String
  studentId     String
  answers       Json?
  textAnswer    String?   @db.Text
  fileUrls      Json?
  score         Int?
  feedback      String?   @db.Text
  status        String    @default("pending")
  attemptNumber Int       @default(1)
  isLate        Boolean   @default(false)
  submittedAt   DateTime  @default(now())
  gradedAt      DateTime?
  gradedBy      String?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

model Announcement {
  id        String   @id @default(cuid())
  teacherId String
  groupId   String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())

  teacher User         @relation(fields: [teacherId], references: [id])
  group   TeacherGroup @relation(fields: [groupId], references: [id])
}

// ═══════════════════════════════════════════════════════════════
// O'QITUVCHI QUIZLARI
// ═══════════════════════════════════════════════════════════════

model TeacherQuiz {
  id               String  @id @default(cuid())
  teacherId        String
  groupId          String?
  title            String
  description      String? @db.Text
  timeLimit        Int?
  isPublic         Boolean @default(false)
  accessCode       String?
  shuffleQuestions Boolean @default(true)
  showResults      Boolean @default(true)

  // Bu maydonlar ustoz interfeysida allaqachon bor edi, lekin sxemada yo'q edi.
  // Natijada:
  //   • talaba ro'yxati `where: { isDraft: false }` da qulab tushardi
  //   • maxAttempts undefined bo'lgani uchun urinishlar cheklovi ishlamasdi
  //   • qiymatlar `description` ichiga JSON matn sifatida tiqilardi
  // ClosedQuiz'da bular allaqachon to'g'ri ta'riflangan — shu bilan moslashtirildi.
  isDraft      Boolean   @default(false)
  maxAttempts  Int       @default(1) // 99 = cheksiz
  passingScore Int       @default(60)
  deadline     DateTime?

  totalAttempts Int      @default(0)
  avgScore      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher   User                  @relation(fields: [teacherId], references: [id])
  group     TeacherGroup?         @relation(fields: [groupId], references: [id])
  questions TeacherQuizQuestion[]
  attempts  TeacherQuizAttempt[]

  @@index([teacherId])
  @@index([groupId])
  @@index([accessCode])
}

model TeacherQuizQuestion {
  id            String  @id @default(cuid())
  quizId        String
  questionText  String  @db.Text
  options       Json
  correctAnswer Int
  explanation   String? @db.Text
  points        Int     @default(1)
  order         Int     @default(0)

  quiz TeacherQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model TeacherQuizAttempt {
  id          String   @id @default(cuid())
  // Bir tokenni ikki marta topshirish ikkinchi urinish va XP yaratmasin.
  attemptId   String?  @unique
  quizId      String
  studentId   String
  answers     Json
  score       Int
  maxScore    Int
  percentage  Float
  timeSpent   Int
  completedAt DateTime @default(now())

  quiz    TeacherQuiz @relation(fields: [quizId], references: [id])
  student User        @relation(fields: [studentId], references: [id])

  @@index([quizId])
  @@index([studentId])
}

// ═══════════════════════════════════════════════════════════════
// 🆕 VARIANTSIZ QUIZ (YOPIQ QUIZ)
// ═══════════════════════════════════════════════════════════════

model ClosedQuiz {
  id        String  @id @default(cuid())
  teacherId String
  groupId   String?

  title        String
  description  String? @db.Text
  instructions String? @db.Text // Talaba uchun ko'rsatmalar

  timeLimit   Int? // daqiqalarda
  maxAttempts Int  @default(1)
  maxScore    Int  @default(100)

  isDraft  Boolean   @default(false)
  deadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher     User                   @relation(fields: [teacherId], references: [id])
  group       TeacherGroup?          @relation(fields: [groupId], references: [id])
  questions   ClosedQuizQuestion[]
  submissions ClosedQuizSubmission[]

  @@index([teacherId])
  @@index([groupId])
}

model ClosedQuizQuestion {
  id     String @id @default(cuid())
  quizId String

  questionText String  @db.Text
  maxPoints    Int     @default(10)
  order        Int     @default(0)
  hint         String? @db.Text

  quiz ClosedQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model ClosedQuizSubmission {
  id        String @id @default(cuid())
  quizId    String
  studentId String

  answers   Json // [{questionId, answer}]
  timeSpent Int  @default(0) // soniyalarda

  status   String    @default("pending") // pending, graded, returned
  score    Int?
  maxScore Int
  feedback String?   @db.Text // Umumiy izoh
  gradedBy String?
  gradedAt DateTime?

  submittedAt DateTime @default(now())

  quiz    ClosedQuiz @relation(fields: [quizId], references: [id])
  student User       @relation(fields: [studentId], references: [id])

  @@index([quizId])
  @@index([studentId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// 🆕 O'QITUVCHI OMMAVIY AKADEMIK PROFILI
// ═══════════════════════════════════════════════════════════════

model TeacherPublicProfile {
  id     String @id @default(cuid())
  userId String @unique

  // ═══ ASOSIY AKADEMIK MA'LUMOTLAR ═══
  displayName String? // Ko'rsatiladigan ism (masalan: "Prof. A. Karimov")
  title       String? // Ilmiy unvon: "Kimyo fanlari doktori", "dotsent"
  bio         String? @db.Text // O'zi haqida qisqacha
  university  String? // Universitet nomi
  department  String? // Kafedra: "Organik kimyo kafedrasi"
  position    String? // Lavozim: "Kafedra mudiri", "Katta o'qituvchi"

  // ═══ ILMIY FAOLIYAT ═══
  experienceYears Int? // Yillik tajriba
  specialties     Json? // ["Koordinatsion kimyo", "Spektroskopiya", "Kristallografiya"]
  education       Json? // [{degree: "PhD", university: "SamDU", year: 2015}, ...]
  publications    Int? // Ilmiy maqolalar soni
  citations       Int? // Iqtiboslar soni
  hIndex          Int? // h-index
  awards          Json? // [{title: "Beruniy mukofoti", year: 2020}, ...]

  // ═══ TADQIQOT YO'NALISHLARI ═══
  researchAreas   Json? // [{name: "Kompleks birikmalar", description: "..."}]
  currentProjects Json? // Hozirgi loyihalar

  // ═══ DARS BERADIGAN KURSLAR ═══
  courses Json? // [{name: "Organik kimyo", semester: "3", credits: 6}]

  // ═══ AKADEMIK TARMOQLAR ═══
  website       String?
  googleScholar String?
  researchGate  String?
  orcid         String?
  scopus        String?

  // ═══ ALOQA (sozlanadigan) ═══
  showEmail        Boolean @default(false)
  showPhone        Boolean @default(false)
  showStats        Boolean @default(true)
  showCourses      Boolean @default(true)
  showPublications Boolean @default(true)

  // ═══ VIZUAL ═══
  themeColor  String  @default("purple") // purple, blue, green, indigo, amber
  coverImage  String? // Qopqoq rasmi URL
  bannerQuote String? // Iqtibos (banner'da ko'rinadi)

  // ═══ META ═══
  isActive   Boolean  @default(true)
  isVerified Boolean  @default(false) // Admin tomonidan tasdiqlangan
  views      Int      @default(0) // Profil ko'rishlar soni
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([university])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════════
// MAQOLA STATISTIKASI
// ═══════════════════════════════════════════════════════════════
//
// Maqola matni hozircha public/data/maqolalar.json faylida turadi, lekin
// ko'rish/yuklash sonlari o'sha faylda statik raqam bo'lib qolgan edi —
// maqola ochilganda ham o'zgarmasdi (Vercel'da fayl tizimi yozishga yopiq).
//
// Shu sababli sanoqchilar bazada, articleId bo'yicha alohida saqlanadi.
// ForumPost.articleId bilan bir xil kelishuv: oddiy matn, tashqi kalit emas.
// Maqolalar bazaga ko'chirilsa, id'lar shu holicha mos keladi.

model ArticleStat {
  id        String @id @default(cuid())
  articleId String @unique

  views     Int @default(0)
  downloads Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([views])
}
