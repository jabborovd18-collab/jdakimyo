generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// ASOSIY FOYDALANUVCHI (USER)
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  userId        String    @unique
  username      String    @unique
  email         String    @unique
  password      String
  fullName      String?
  role          String    @default("bakalavr")
  university    String?
  faculty       String?
  specialty     String?
  level         Int?
  avatar        String?
  bio           String?
  telegram      String?
  instagram     String?
  linkedin      String?
  location      String?
  level_points  Int       @default(1)
  experience    Int       @default(0)
  totalPoints   Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActive    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isBanned      Boolean   @default(false)
  bannedAt      DateTime?
  bannedReason  String?
  // Yulduz — akkaunt darajasi va reyting uchun. U SARFLANMAYDI:
  // sarflansa, xarid qilgan odam leaderboard'da pastga tushib, o'ynagani
  // uchun jazolangan bo'lardi. Laboratoriya uchun alohida valyuta bor.
  stars         Int       @default(0)
  weeklyStars   Int       @default(0)
  monthlyStars  Int       @default(0)
  totalMissions Int       @default(0)

  // ─── Laboratoriya valyutalari ───
  // coins — arzon posilka va oddiy jihoz, missiyadan topiladi
  // gems  — ruda namunasi va nodir reagent, kam topiladi (keyinchalik xarid)
  coins                Int   @default(0)
  gems                 Int   @default(0)
  privacySettings      Json  @default("{\"profilePublic\": true, \"showFriends\": true, \"showQuizResults\": true, \"showAchievements\": true, \"showFollowers\": true}")
  notificationSettings Json?
  interfaceSettings    Json?
  learningPreferences  Json?

  // AUTH
  accounts Account[]
  sessions Session[]

  // QUIZ VA SERTIFIKATLAR
  quizResults  QuizResult[]
  certificates Certificate[]

  // Admin sifatida bergan sertifikatlar
  issuedCertificates Certificate[] @relation("CertificateIssuer")

  // DO'STLIK VA IJTIMOIY
  sentRequests     FriendRequest[] @relation("Sender")
  receivedRequests FriendRequest[] @relation("Receiver")
  friendships1     Friendship[]    @relation("User1")
  friendships2     Friendship[]    @relation("User2")
  followers        Follow[]        @relation("Following")
  following        Follow[]        @relation("Follower")

  // GAMIFICATION
  achievements       Achievement[]
  missionCompletions MissionCompletion[]
  dailyActivities    DailyActivity[]

  // 🆕 Yopiq quizlar
  createdClosedQuizzes  ClosedQuiz[]
  closedQuizSubmissions ClosedQuizSubmission[]

  // 🆕 Ommaviy akademik profil
  publicProfile TeacherPublicProfile?

  // 🆕 KENGAYTIRILGAN MA'LUMOTLAR
  birthDate      DateTime?
  academicDegree String?
  studentId      String?
  enrollmentYear Int?
  github         String?
  twitter        String?
  website        String?
  googleScholar  String?
  orcid          String?

  // MODERATION
  reportsMade     Report[]   @relation("Reporter")
  reportsReceived Report[]   @relation("ReportTarget")
  auditLogs       AuditLog[]

  // Kimyogar tasdiqlagan reaksiyalar
  verifiedReactions Reaction[] @relation("ReactionVerifier")

  // KIMYOGAR KO'CHAT
  plant Plant?

  // LABORATORIYA
  lab Lab?

  // MUHOKAMA (FORUM)
  forumPosts     ForumPost[] @relation("ForumAuthor")
  forumModerated ForumPost[] @relation("ForumModerator")
  forumLikes     ForumLike[]

  // O'QITUVCHI PANELI - USTOZ SIFATIDA
  teacherStudents TeacherStudent[] @relation("TeacherStudents")
  teacherGroups   TeacherGroup[]
  assignments     Assignment[]
  announcements   Announcement[]
  createdQuizzes  TeacherQuiz[]

  // O'QITUVCHI PANELI - TALABA SIFATIDA
  studentTeachers       TeacherStudent[]       @relation("StudentTeachers")
  assignmentSubmissions AssignmentSubmission[]
  quizAttempts          TeacherQuizAttempt[]
}

// ═══════════════════════════════════════════════════════════════
// AUTH (NextAuth)
// ═══════════════════════════════════════════════════════════════

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════════════════════════════
// QUIZ VA SERTIFIKATLAR
// ═══════════════════════════════════════════════════════════════

model QuizResult {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizName       String
  score          Int
  percentage     Float
  timeSpent      Int
  totalQuestions Int
  completedAt    DateTime @default(now())
}

// Sertifikatni FAQAT admin beradi va hamma ma'lumotni admin panelda kiritadi.
// Avval sahifada foydalanuvchining o'zi ism va ball yozib PDF yasay olardi —
// u bazaga umuman yozilmasdi, ya'ni sertifikat hech narsani tasdiqlamasdi.
model Certificate {
  id     String @id @default(cuid())
  certId String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ─── Sertifikatda chop etiladigan ma'lumot ───
  // Ism-familya sertifikatning o'zida saqlanadi, User.fullName'dan olinmaydi:
  // profilda taxallus yozilgan bo'lishi mumkin, sertifikatda esa rasmiy ism
  // turishi shart. Profil keyin o'zgarsa ham berilgan sertifikat o'zgarmaydi.
  fullName    String
  fan         String // qaysi fan uchun berilgan (hozircha matn, keyin Fan modeliga bog'lanadi)
  reason      String // nima uchun berilgan
  description String? @db.Text
  seals       Json? // pechatlar: [{url, label}]

  // ─── Kim berdi ───
  // Reaksiya tasdig'idagi naqsh: admin o'chirilsa bog'lanish uziladi,
  // lekin sertifikatning o'zi va berilgan sanasi joyida qoladi.
  issuedById String?
  issuedBy   User?   @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  // ─── Baho — ixtiyoriy ───
  // Quiz asosida beriladigan sertifikat uchun. Admin qo'lda bergan
  // sertifikatda (masalan olimpiada g'olibi) ball umuman bo'lmasligi mumkin.
  examName   String?
  grade      String?
  score      Int?
  percentage Float?
  percentile Float?

  issuedAt  DateTime  @default(now())
  expiresAt DateTime? // muddatsiz sertifikat uchun bo'sh qoldiriladi
  status    String    @default("valid")

  @@index([userId])
  @@index([fan])
  @@index([issuedById])
  @@index([status])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  category    String
  question    String   @db.Text
  options     Json
  correct     Int
  explanation String?  @db.Text
  difficulty  String   @default("o'rta")
  tags        Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([difficulty])
}

// ═══════════════════════════════════════════════════════════════
// DO'STLIK VA IJTIMOIY
// ═══════════════════════════════════════════════════════════════

model Friendship {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  user1     User     @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  sender     User     @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  message    String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

// ═══════════════════════════════════════════════════════════════
// GAMIFICATION
// ═══════════════════════════════════════════════════════════════

model Achievement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String
  name           String
  description    String
  icon           String
  rarity         String
  earnedAt       DateTime @default(now())

  @@unique([userId, achievementKey])
}

model AchievementDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @db.Text
  icon        String   @default("🏆")
  rarity      String   @default("common")
  category    String   @default("general")
  requirement String?  @db.Text
  xpReward    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([rarity])
  @@index([isActive])
}

model Mission {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  type        String
  title       String
  description String
  xpReward    Int
  icon        String
  difficulty  String   @default("easy")
  createdAt   DateTime @default(now())

  completions MissionCompletion[]

  @@unique([date, type])
}

model MissionCompletion {
  id          String   @id @default(cuid())
  userId      String
  missionId   String
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
}

model DailyActivity {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date
  quizCount     Int      @default(0)
  videoCount    Int      @default(0)
  compoundCount Int      @default(0)
  missionCount  Int      @default(0)
  totalXP       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ═══════════════════════════════════════════════════════════════
// KIMYO MAZMUNI
// ═══════════════════════════════════════════════════════════════

model Compound {
  id                 String   @id @default(cuid())
  formula            String
  name               String
  centralAtom        String
  ligands            String
  coordinationNumber Int
  geometry           String
  oxidationState     Int
  color              String?
  category           String
  description        String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  molecule3D Molecule3D?
}

model Molecule3D {
  id                 String  @id @default(cuid())
  name               String
  formula            String
  smiles             String?
  molData            String  @db.Text
  pdbData            String? @db.Text
  category           String
  centralAtom        String
  ligands            String
  coordinationNumber Int
  geometry           String
  description        String? @db.Text
  color              String  @default("blue")
  isFeatured         Boolean @default(false)
  isActive           Boolean @default(true)

  compoundId String?   @unique
  compound   Compound? @relation(fields: [compoundId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([centralAtom])
  @@index([isFeatured])
}

// ═══════════════════════════════════════════════════════════════
// MUHOKAMA (FORUM)
// ═══════════════════════════════════════════════════════════════
//
// Ikki xil ishlatiladi:
//   • articleId = null  -> umumiy lenta (dolzarb kimyoviy mavzular)
//   • articleId = "3"   -> shu maqola ostidagi muhokama
//
// Maqolalar hozircha public/data/maqolalar.json faylida saqlangani uchun
// articleId tashqi kalit emas, oddiy matn. Maqolalar bazaga ko'chirilsa,
// id'lar shu holicha mos keladi.

model ForumPost {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation("ForumAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  articleId String? // null = umumiy lenta
  title     String? // faqat yangi mavzu ochilganda (javoblarda bo'sh)
  content   String  @db.Text

  // Javob zanjiri
  parentId String?
  parent   ForumPost?  @relation("ForumReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ForumPost[] @relation("ForumReplies")

  // Moderatsiya — post admin tasdiqlagandan keyin ko'rinadi
  status        String    @default("pending") // pending | approved | rejected
  moderatedById String?
  moderatedBy   User?     @relation("ForumModerator", fields: [moderatedById], references: [id])
  moderatedAt   DateTime?
  rejectReason  String?   @db.Text

  isPinned Boolean     @default(false)
  likes    ForumLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([articleId])
  @@index([parentId])
  @@index([createdAt])
}

model ForumLike {
  id     String @id @default(cuid())
  postId String
  userId String

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// ═══════════════════════════════════════════════════════════════
// KIMYOVIY REAKSIYALAR
// ═══════════════════════════════════════════════════════════════

model Reaction {
  id String @id @default(cuid())

  // ─── Asosiy ───
  equation     String  @db.Text // "H₂SO₄ + 2NaOH → Na₂SO₄ + 2H₂O"
  name         String? // "Sulfat kislotaning neytrallanishi"
  description  String? @db.Text
  category     String // Asid-baza, Redoks, Sintez, Parchalanish...
  reactionType String? // neytrallanish, almashinish, qo'shilish...

  // ─── Qidiruv indeksi ───
  // lib/chem-search.js to'ldiradi. Formuladagi pastki indekslar oddiy
  // raqamga aylantiriladi, shunda "H2SO4" deb qidirilsa ham "H₂SO₄" topiladi.
  searchText    String @db.Text
  searchCompact String @db.Text

  // ─── Borish sharoiti ───
  temperature String? // "25°C", "400-500°C"
  pressure    String? // "1 atm", "150-300 atm"
  catalyst    String? // "V₂O₅", "Fe", "Yo'q"
  environment String? // "kislotali muhit", "inert atmosfera"

  // ─── Mexanizm va oraliq moddalar ───
  mechanism     String? @db.Text
  intermediates Json? // [{formula, name, note}]

  // ─── Erituvchi ───
  solvents      Json? // [{name, efficiency, note}] — samaradorlik solishtiruvi
  bestSolvent   String? // eng samarali erituvchi
  solventEffect String? @db.Text // erituvchi reaksiyaga qanday ta'sir qiladi

  // ─── Qo'llanilish ko'lami ───
  scale     String? // laboratoriya | sanoat | ikkalasi | nazariy
  scaleNote String? @db.Text

  // ─── Tezlikni oshirish omillari ───
  rateFactors Json? // [{factor, effect}]

  // ─── Amaliy tomoni ───
  techniques   Json? // ["Qaytar sovutgich", "Distillash", "Filtrlash"]
  equipment    Json? // kerakli asbob-uskunalar
  hazards      Json? // xavfsizlik ogohlantirishlari
  observations String? @db.Text // rang o'zgarishi, gaz ajralishi, cho'kma
  yieldInfo    String? // unum haqida

  // ─── Manba va ishonchlilik ───
  source    String? // ma'lumot manbasi (atribut uchun)
  sourceUrl String?

  // ─── Tasdiqlash ───
  // Kimyogar ko'rib chiqib tasdiqlaganmi. Import qilingan ma'lumot
  // avtomatik ravishda false bo'ladi — talabaga tekshirilmagan deb ko'rsatiladi.
  //
  // "Kim tasdiqladi" saqlanishi shart: tasdiq javobgarlik bilan keladi.
  // Foydalanuvchi o'chirilsa bog'lanish uziladi, lekin tasdiq sanasi qoladi.
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("ReactionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([scale])
  @@index([isActive])
  @@index([isVerified])
  @@index([verifiedById])
}

model AnalysisMethod {
  id            String   @id @default(cuid())
  name          String
  nameUz        String
  nameEn        String?
  category      String
  description   String   @db.Text
  application   String?  @db.Text
  advantages    String?  @db.Text
  disadvantages String?  @db.Text
  accuracy      String?
  cost          String?
  time          String?
  icon          String   @default("🔬")
  color         String   @default("blue")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════════
// MODERATION VA ADMIN
// ═══════════════════════════════════════════════════════════════

model Report {
  id         String    @id @default(cuid())
  reporterId String
  targetId   String
  targetType String
  reason     String    @db.Text
  category   String    @default("spam")
  status     String    @default("pending")
  priority   String    @default("medium")
  reviewedBy String?
  reviewedAt DateTime?
  resolution String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id])
  target   User @relation("ReportTarget", fields: [targetId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// LABORATORIYA
// ═══════════════════════════════════════════════════════════════

// Laboratoriya katalogi: reagentlar, jihozlar va texnikalar.
//
// Manbasi — data/laboratoriya/ dagi fayllar, ular seed skript bilan shu
// yerga ko'chiriladi (data/reactions → Reaction bilan bir xil naqsh).
//
// Reagentlar reaksiyalar bazasidan generatsiya qilinadi: nodirlik va narx
// modda nechta reaksiyada uchrashidan chiqadi. Ya'ni o'yin iqtisodiyoti
// o'ylab topilmagan, kimyoning o'zidan kelib chiqqan.
model LabItemDef {
  id     String  @id @default(cuid())
  kalit  String  @unique // "H₂O", "probirka", "titrlash"
  nom    String
  turi   String // "reagent" | "jihoz" | "texnika"
  guruh  String? // jihoz uchun: shisha, isitish, olchov, himoya, sanoat...
  icon   String?
  tavsif String? @db.Text

  // ─── Nodirlik va narx ───
  nodirlik    String @default("oddiy") // oddiy | kam | nodir | noyob
  uchraydi    Int    @default(0) // nechta reaksiyada reagent — nodirlik shundan
  chiqadi     Int    @default(0) // nechta reaksiyada mahsulot (tajribada olinadi)
  narx        Int    @default(0) // coins; 0 — sotilmaydi, faqat tajribada yasaladi
  sotishNarxi Int    @default(0) // coins; xarid narxidan past
  gemsNarxi   Int? // to'g'ridan-to'g'ri olmos xaridi (sandiqqa muqobil yo'l)

  // ─── Xossalar ───
  sarflanadi Boolean @default(false) // ishlatilganda yo'qoladi (filtr qog'ozi)
  sanoat     Boolean @default(false) // talaba laboratoriyasida bo'lmaydi
  daraja     Int     @default(1) // ochilishi uchun kerakli laboratoriya darajasi

  // Reaksiyalarni katalogga bog'lash uchun: bazadagi xom equipment/techniques
  // qiymatlari (bir jihozning bir necha nomi bo'lishi mumkin).
  xom     Json?
  oilalar Json? // reagent qaysi reaksiya oilalarida uchraydi

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventarda LabItem[]

  @@index([turi])
  @@index([nodirlik])
  @@index([guruh])
  @@index([isActive])
}

// Foydalanuvchining laboratoriyasi. Bo'sh boshlanadi — jihozlar sotib
// olinadi, reagentlar sandiqdan yoki do'kondan keladi.
model Lab {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nom String @default("Mening laboratoriyam")

  // `tajriba` — asosiy son, `daraja` esa undan hisoblanadi (lib/tajriba.js).
  // Daraja shu yerda ham saqlanadi, chunki u xarid va texnika darvozasida
  // tekshiriladi: har safar qayta hisoblash o'rniga bir joyda — tajriba
  // o'tkazilganda — yangilanadi.
  daraja  Int @default(1)
  tajriba Int @default(0) // laboratoriya XP — tajriba o'tkazgan sari o'sadi

  // Kunlik sandiq oxirgi marta qachon olingani. Kun chegarasi UTC yarim
  // tuni — kunlik missiyalar bilan bir xil, aks holda "bugun" ikki xil
  // ma'noda ishlatilardi.
  oxirgiKunlikSandiq DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        LabItem[]
  transactions LabTransaction[]
  experiments  LabExperiment[]
}

// O'tkazilgan tajribalar jurnali.
//
// Nega saqlanadi: "shu reaksiyani birinchi marta qilyapsanmi" degan savolga
// javob shu yerdan chiqadi — kashfiyot mukofoti aynan shunga bog'liq. Undan
// tashqari bu foydalanuvchining laboratoriya daftari: nimani qachon olgani
// ko'rinib turadi.
//
// `reactionId` ataylab oddiy matn, bog'lanish emas: reaksiya bazadan
// o'chirilsa ham daftardagi yozuv qolishi kerak. Shu sababli tenglama ham
// nusxa qilib saqlanadi — o'sha kungi ko'rinishi bilan.
model LabExperiment {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  reactionId String
  equation   String @db.Text

  tajriba  Int     @default(0) // shu tajriba uchun berilgan XP
  birinchi Boolean @default(false) // shu reaksiya ilk marta o'tkazildimi

  createdAt DateTime @default(now())

  @@index([labId])
  @@index([labId, reactionId])
  @@index([createdAt])
}

// Inventar: kim nimaga ega va nechta.
//
// `kalit` LabItemDef ga bog'langan. Katalogdan chiqarilgan yozuv
// o'chirilmaydi (isActive=false bo'ladi), shuning uchun inventar hech
// qachon "yo'q narsaga" ishora qilib qolmaydi.
model LabItem {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  kalit String
  def   LabItemDef @relation(fields: [kalit], references: [kalit], onDelete: Restrict)

  soni Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labId, kalit])
  @@index([labId])
  @@index([kalit])
}

// Tanga va olmos harakati.
//
// Balansning o'zi yetarli emas: nimadir noto'g'ri ketsa yoki kimdir
// aldashga urinsa, "qayerdan keldi va qayerga ketdi" degan savolga
// javob shu jadvaldan chiqadi.
model LabTransaction {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  turi      String // "xarid" | "sotish" | "sandiq" | "mukofot"
  valyuta   String // "coins" | "gems"
  miqdor    Int // musbat — kelgan, manfiy — ketgan
  kalit     String? // qaysi buyum bilan bog'liq
  soni      Int? // nechta dona
  izoh      String?
  createdAt DateTime @default(now())

  @@index([labId])
  @@index([turi])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  details    String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model SiteSettings {
  id                 String   @id @default("main")
  siteName           String   @default("JDA KIMYO")
  siteDescription    String   @default("Koordinatsion kimyo platformasi")
  logo               String?
  favicon            String?
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?  @db.Text
  footerText         String?  @db.Text
  contactEmail       String?
  contactPhone       String?
  telegramGroup      String?
  instagramLink      String?
  defaultXpCommon    Int      @default(10)
  defaultXpRare      Int      @default(50)
  defaultXpEpic      Int      @default(100)
  defaultXpLegendary Int      @default(500)
  questionsPerQuiz   Int      @default(20)
  quizTimeLimit      Int?
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

// ═══════════════════════════════════════════════════════════════
// MOTIVATSION GAPLAR
// ═══════════════════════════════════════════════════════════════

model DailyQuote {
  id          String    @id @default(cuid())
  textUz      String    @db.Text
  textEn      String?   @db.Text
  author      String
  authorInfo  String?   @db.Text
  category    String    @default("motivation")
  tags        String[]
  icon        String    @default("💡")
  color       String    @default("purple")
  isActive    Boolean   @default(true)
  displayDate DateTime?
  timesShown  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([displayDate])
}

// ═══════════════════════════════════════════════════════════════
// KIMYOGAR KO'CHAT
// ═══════════════════════════════════════════════════════════════

model Plant {
  id             String    @id @default(cuid())
  userId         String    @unique
  name           String    @default("Kimyogar Ko'chat")
  stage          Int       @default(1)
  growth         Float     @default(0)
  totalWaterings Int       @default(0)
  lastWatered    DateTime?
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  activeBoosts   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  waterings PlantWatering[]

  @@index([userId])
  @@index([stage])
}

model PlantWatering {
  id        String   @id @default(cuid())
  plantId   String
  growth    Float
  boostUsed String?
  createdAt DateTime @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// O'QITUVCHI PANELI
// ═══════════════════════════════════════════════════════════════

model TeacherStudent {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  groupId   String?
  joinedAt  DateTime @default(now())

  teacher User          @relation("TeacherStudents", fields: [teacherId], references: [id])
  student User          @relation("StudentTeachers", fields: [studentId], references: [id])
  group   TeacherGroup? @relation(fields: [groupId], references: [id])

  @@unique([teacherId, studentId, groupId])
}

model TeacherGroup {
  id          String   @id @default(cuid())
  teacherId   String
  name        String
  description String?
  color       String   @default("blue")
  createdAt   DateTime @default(now())

  teacher       User             @relation(fields: [teacherId], references: [id])
  students      TeacherStudent[]
  assignments   Assignment[]
  announcements Announcement[]
  quizzes       TeacherQuiz[]
  closedQuizzes ClosedQuiz[]
}

model Assignment {
  id                  String    @id @default(cuid())
  teacherId           String
  groupId             String
  title               String
  description         String    @db.Text
  type                String
  deadline            DateTime
  timeLimit           Int?
  startDate           DateTime?
  maxScore            Int       @default(100)
  passingScore        Int?
  gradingCriteria     Json?
  maxAttempts         Int       @default(1)
  allowLateSubmission Boolean   @default(false)
  latePenalty         Float     @default(10)
  instructions        String?   @db.Text
  attachments         Json?
  hints               Json?
  resources           Json?
  isDraft             Boolean   @default(false)
  visibility          String    @default("group")
  requireFile         Boolean   @default(false)
  allowedFileTypes    String?
  maxFileSize         Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  teacher     User                   @relation(fields: [teacherId], references: [id])
  group       TeacherGroup           @relation(fields: [groupId], references: [id])
  submissions AssignmentSubmission[]

  @@index([teacherId])
  @@index([groupId])
  @@index([deadline])
  @@index([isDraft])
  @@index([type])
}

model AssignmentSubmission {
  id            String    @id @default(cuid())
  assignmentId  String
  studentId     String
  answers       Json?
  textAnswer    String?   @db.Text
  fileUrls      Json?
  score         Int?
  feedback      String?   @db.Text
  status        String    @default("pending")
  attemptNumber Int       @default(1)
  isLate        Boolean   @default(false)
  submittedAt   DateTime  @default(now())
  gradedAt      DateTime?
  gradedBy      String?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

model Announcement {
  id        String   @id @default(cuid())
  teacherId String
  groupId   String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())

  teacher User         @relation(fields: [teacherId], references: [id])
  group   TeacherGroup @relation(fields: [groupId], references: [id])
}

// ═══════════════════════════════════════════════════════════════
// O'QITUVCHI QUIZLARI
// ═══════════════════════════════════════════════════════════════

model TeacherQuiz {
  id               String  @id @default(cuid())
  teacherId        String
  groupId          String?
  title            String
  description      String? @db.Text
  timeLimit        Int?
  isPublic         Boolean @default(false)
  accessCode       String?
  shuffleQuestions Boolean @default(true)
  showResults      Boolean @default(true)

  // Bu maydonlar ustoz interfeysida allaqachon bor edi, lekin sxemada yo'q edi.
  // Natijada:
  //   • talaba ro'yxati `where: { isDraft: false }` da qulab tushardi
  //   • maxAttempts undefined bo'lgani uchun urinishlar cheklovi ishlamasdi
  //   • qiymatlar `description` ichiga JSON matn sifatida tiqilardi
  // ClosedQuiz'da bular allaqachon to'g'ri ta'riflangan — shu bilan moslashtirildi.
  isDraft      Boolean   @default(false)
  maxAttempts  Int       @default(1) // 99 = cheksiz
  passingScore Int       @default(60)
  deadline     DateTime?

  totalAttempts Int      @default(0)
  avgScore      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher   User                  @relation(fields: [teacherId], references: [id])
  group     TeacherGroup?         @relation(fields: [groupId], references: [id])
  questions TeacherQuizQuestion[]
  attempts  TeacherQuizAttempt[]

  @@index([teacherId])
  @@index([groupId])
  @@index([accessCode])
}

model TeacherQuizQuestion {
  id            String  @id @default(cuid())
  quizId        String
  questionText  String  @db.Text
  options       Json
  correctAnswer Int
  explanation   String? @db.Text
  points        Int     @default(1)
  order         Int     @default(0)

  quiz TeacherQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model TeacherQuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  studentId   String
  answers     Json
  score       Int
  maxScore    Int
  percentage  Float
  timeSpent   Int
  completedAt DateTime @default(now())

  quiz    TeacherQuiz @relation(fields: [quizId], references: [id])
  student User        @relation(fields: [studentId], references: [id])

  @@index([quizId])
  @@index([studentId])
}

// ═══════════════════════════════════════════════════════════════
// 🆕 VARIANTSIZ QUIZ (YOPIQ QUIZ)
// ═══════════════════════════════════════════════════════════════

model ClosedQuiz {
  id        String  @id @default(cuid())
  teacherId String
  groupId   String?

  title        String
  description  String? @db.Text
  instructions String? @db.Text // Talaba uchun ko'rsatmalar

  timeLimit   Int? // daqiqalarda
  maxAttempts Int  @default(1)
  maxScore    Int  @default(100)

  isDraft  Boolean   @default(false)
  deadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher     User                   @relation(fields: [teacherId], references: [id])
  group       TeacherGroup?          @relation(fields: [groupId], references: [id])
  questions   ClosedQuizQuestion[]
  submissions ClosedQuizSubmission[]

  @@index([teacherId])
  @@index([groupId])
}

model ClosedQuizQuestion {
  id     String @id @default(cuid())
  quizId String

  questionText String  @db.Text
  maxPoints    Int     @default(10)
  order        Int     @default(0)
  hint         String? @db.Text

  quiz ClosedQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model ClosedQuizSubmission {
  id        String @id @default(cuid())
  quizId    String
  studentId String

  answers   Json // [{questionId, answer}]
  timeSpent Int  @default(0) // soniyalarda

  status   String    @default("pending") // pending, graded, returned
  score    Int?
  maxScore Int
  feedback String?   @db.Text // Umumiy izoh
  gradedBy String?
  gradedAt DateTime?

  submittedAt DateTime @default(now())

  quiz    ClosedQuiz @relation(fields: [quizId], references: [id])
  student User       @relation(fields: [studentId], references: [id])

  @@index([quizId])
  @@index([studentId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// 🆕 O'QITUVCHI OMMAVIY AKADEMIK PROFILI
// ═══════════════════════════════════════════════════════════════

model TeacherPublicProfile {
  id     String @id @default(cuid())
  userId String @unique

  // ═══ ASOSIY AKADEMIK MA'LUMOTLAR ═══
  displayName String? // Ko'rsatiladigan ism (masalan: "Prof. A. Karimov")
  title       String? // Ilmiy unvon: "Kimyo fanlari doktori", "dotsent"
  bio         String? @db.Text // O'zi haqida qisqacha
  university  String? // Universitet nomi
  department  String? // Kafedra: "Organik kimyo kafedrasi"
  position    String? // Lavozim: "Kafedra mudiri", "Katta o'qituvchi"

  // ═══ ILMIY FAOLIYAT ═══
  experienceYears Int? // Yillik tajriba
  specialties     Json? // ["Koordinatsion kimyo", "Spektroskopiya", "Kristallografiya"]
  education       Json? // [{degree: "PhD", university: "SamDU", year: 2015}, ...]
  publications    Int? // Ilmiy maqolalar soni
  citations       Int? // Iqtiboslar soni
  hIndex          Int? // h-index
  awards          Json? // [{title: "Beruniy mukofoti", year: 2020}, ...]

  // ═══ TADQIQOT YO'NALISHLARI ═══
  researchAreas   Json? // [{name: "Kompleks birikmalar", description: "..."}]
  currentProjects Json? // Hozirgi loyihalar

  // ═══ DARS BERADIGAN KURSLAR ═══
  courses Json? // [{name: "Organik kimyo", semester: "3", credits: 6}]

  // ═══ AKADEMIK TARMOQLAR ═══
  website       String?
  googleScholar String?
  researchGate  String?
  orcid         String?
  scopus        String?

  // ═══ ALOQA (sozlanadigan) ═══
  showEmail        Boolean @default(false)
  showPhone        Boolean @default(false)
  showStats        Boolean @default(true)
  showCourses      Boolean @default(true)
  showPublications Boolean @default(true)

  // ═══ VIZUAL ═══
  themeColor  String  @default("purple") // purple, blue, green, indigo, amber
  coverImage  String? // Qopqoq rasmi URL
  bannerQuote String? // Iqtibos (banner'da ko'rinadi)

  // ═══ META ═══
  isActive   Boolean  @default(true)
  isVerified Boolean  @default(false) // Admin tomonidan tasdiqlangan
  views      Int      @default(0) // Profil ko'rishlar soni
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([university])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════════
// MAQOLA STATISTIKASI
// ═══════════════════════════════════════════════════════════════
//
// Maqola matni hozircha public/data/maqolalar.json faylida turadi, lekin
// ko'rish/yuklash sonlari o'sha faylda statik raqam bo'lib qolgan edi —
// maqola ochilganda ham o'zgarmasdi (Vercel'da fayl tizimi yozishga yopiq).
//
// Shu sababli sanoqchilar bazada, articleId bo'yicha alohida saqlanadi.
// ForumPost.articleId bilan bir xil kelishuv: oddiy matn, tashqi kalit emas.
// Maqolalar bazaga ko'chirilsa, id'lar shu holicha mos keladi.

model ArticleStat {
  id        String @id @default(cuid())
  articleId String @unique

  views     Int @default(0)
  downloads Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([views])
}
