generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// ASOSIY FOYDALANUVCHI (USER)
// ═══════════════════════════════════════════════════════════════

model User {
  id       String  @id @default(cuid())
  userId   String  @unique
  username String  @unique
  email    String  @unique
  password String
  fullName String?
  role     String  @default("bakalavr")

  // ─── Ustozlik — IKKILAMCHI rol ───
  // `role` bitta maydon bo'lgani uchun odam bir vaqtda ham admin, ham
  // ustoz bo'la olmasdi: admin berilsa ustoz paneli yo'qolardi. Ustozlik
  // aslida rol emas, VAZIFA — u asosiy rolga qo'shimcha qilib beriladi.
  // Eski `role='teacher'` yozuvlari migratsiyada shu bayroqqa ko'chirildi.
  isTeacher Boolean @default(false)

  // ─── Tasdiqlangan hisob (galochka) ───
  // Faqat superadmin qo'yadi. Maqsad — soxta hisobdan ajratish, shuning
  // uchun uni tarqatish huquqi eng tor doirada qoladi. Kim va qachon
  // berganini yozib boramiz: keyin "buni kim tasdiqlagan?" degan savolga
  // javob topilsin.
  isVerified    Boolean   @default(false)
  // Tasdiqlangan hisob tanlagan premium bezak (lib/premium.js dagi kalit).
  // Faqat ko'rinish — hech qanday huquq bermaydi, shuning uchun uni
  // foydalanuvchining o'zi almashtiradi.
  premiumUslub  String    @default("kosmik")
  verifiedAt    DateTime?
  verifiedById  String?
  verifiedBy    User?     @relation("UserVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedUsers User[]    @relation("UserVerifier")
  university    String?
  faculty       String?
  specialty     String?
  level         Int?
  avatar        String?
  bio           String?
  telegram      String?
  instagram     String?
  linkedin      String?
  location      String?
  level_points  Int       @default(1)
  experience    Int       @default(0)
  totalPoints   Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActive    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isBanned      Boolean   @default(false)
  bannedAt      DateTime?
  bannedReason  String?

  // ─── Email tasdig'i ───
  // Avval email umuman tekshirilmasdi: format ham, mavjudligi ham.
  // Mavjud bo'lmagan manzil bilan istalgancha akkaunt ochish mumkin edi
  // va ko'p akkaunt ochib tanga yig'ishga hech qanday to'siq yo'q edi.
  // Tasdiqlanmagan hisob saytdan foydalanaveradi, lekin TANGA topa
  // olmaydi — ya'ni ko'p akkaunt ochishning ma'nosi qolmaydi.
  emailVerified DateTime?
  emailTasdiq   EmailTasdiq?

  // ─── Kirishga urinishlar ───
  // Login'da hech qanday cheklov yo'q edi: parolni cheksiz marta
  // taxmin qilish mumkin edi va tezlik ham pasaymasdi. Ketma-ket
  // xatolardan keyin shu hisobga kirish qisqa muddatga to'siladi.
  kirishXatolari   Int       @default(0)
  kirishTaqiqUntil DateTime?
  // Yulduz — akkaunt darajasi va reyting uchun. U SARFLANMAYDI:
  // sarflansa, xarid qilgan odam leaderboard'da pastga tushib, o'ynagani
  // uchun jazolangan bo'lardi. Laboratoriya uchun alohida valyuta bor.
  stars            Int       @default(0)
  weeklyStars      Int       @default(0)
  monthlyStars     Int       @default(0)
  totalMissions    Int       @default(0)

  // ─── Laboratoriya valyutalari ───
  // coins — arzon posilka va oddiy jihoz, missiyadan topiladi
  // gems  — ruda namunasi va nodir reagent, kam topiladi (keyinchalik xarid)
  coins Int @default(0)
  gems  Int @default(0)

  // ─── Sarflash taqiqi ───
  // Superadmin qo'yadi: hisob to'xtatilmaydi (o'qish, quiz, missiya
  // ishlayveradi), faqat XARID qilish yopiladi. Muddat majburiy — taqiq
  // o'zi ochilsin, kimdir uni olib tashlashni unutib qo'ymasin.
  //
  // Tanga ham, olmos ham to'siladi: faqat tangani to'ssak, olmos bilan
  // aylanib o'tish mumkin bo'lardi va taqiqning ma'nosi qolmasdi.
  spendBlockedUntil    DateTime?
  spendBlockedReason   String?
  privacySettings      Json      @default("{\"profilePublic\": true, \"showFriends\": true, \"showQuizResults\": true, \"showAchievements\": true, \"showFollowers\": true}")
  notificationSettings Json?
  interfaceSettings    Json?
  learningPreferences  Json?

  // AUTH
  accounts Account[]
  sessions Session[]

  // QUIZ VA SERTIFIKATLAR
  quizResults  QuizResult[]
  certificates Certificate[]

  // Admin sifatida bergan sertifikatlar
  issuedCertificates Certificate[] @relation("CertificateIssuer")

  // DO'STLIK VA IJTIMOIY
  sentRequests     FriendRequest[] @relation("Sender")
  receivedRequests FriendRequest[] @relation("Receiver")
  friendships1     Friendship[]    @relation("User1")
  friendships2     Friendship[]    @relation("User2")
  followers        Follow[]        @relation("Following")
  following        Follow[]        @relation("Follower")

  // GAMIFICATION
  achievements       Achievement[]
  missionCompletions MissionCompletion[]
  dailyActivities    DailyActivity[]

  // 🆕 Yopiq quizlar
  createdClosedQuizzes  ClosedQuiz[]
  closedQuizSubmissions ClosedQuizSubmission[]

  // 🆕 Ommaviy akademik profil
  publicProfile TeacherPublicProfile?

  // 🆕 KENGAYTIRILGAN MA'LUMOTLAR
  birthDate      DateTime?
  academicDegree String?
  studentId      String?
  enrollmentYear Int?
  github         String?
  twitter        String?
  website        String?
  googleScholar  String?
  orcid          String?

  // MODERATION
  reportsMade     Report[]   @relation("Reporter")
  reportsReceived Report[]   @relation("ReportTarget")
  auditLogs       AuditLog[]

  // Kimyogar tasdiqlagan reaksiyalar
  verifiedReactions Reaction[] @relation("ReactionVerifier")

  // BILDIRISHNOMALAR
  notifications     Notification[] @relation("NotificationUser")
  sentNotifications Notification[] @relation("NotificationAdmin")

  // KANALLAR
  channels    Channel[]             @relation("ChannelOwner")
  channelSubs ChannelSubscription[]

  // PROFIL POSTLARI
  profilePosts ProfilePost[]

  // KUNLIK SOVG'ALAR
  yuborganSovgalar Gift[] @relation("GiftSender")
  kelganSovgalar   Gift[] @relation("GiftReceiver")

  // ELEKTRON DOSKA SESSIYALARI
  doskaSessiyalar DoskaSessiya[] @relation("DoskaFoydalanuvchi")

  // TELEGRAM BOT
  // Nomi `telegram` emas: yuqorida `telegram String?` bor va u
  // butunlay boshqa narsa — profildagi ijtimoiy havola.
  telegramUlanish TelegramUlanish?
  telegramKod     TelegramKod?

  // ─── Shaxsiy chat ───
  // Ogohlantirish soni va yozish taqiqi — laboratoriya xarid taqiqi bilan
  // bir xil naqsh: muddat bilan qo'yiladi va o'zi ochiladi.
  chatWarnings      Int       @default(0)
  chatBlockedUntil  DateTime?
  chatBlockedReason String?

  suhbat1        Conversation[] @relation("Suhbat1")
  suhbat2        Conversation[] @relation("Suhbat2")
  yuborganXabar  Message[]      @relation("XabarYuboruvchi")
  bloklaganlarim UserBlock[]    @relation("Bloklovchi")
  meniBloklagan  UserBlock[]    @relation("Bloklangan")
  chatShikoyat   ChatReport[]   @relation("ShikoyatYuboruvchi")
  chatShikoyati  ChatReport[]   @relation("ShikoyatQilingan")

  // KIMYOGAR KO'CHAT
  plant Plant?

  // LABORATORIYA
  lab Lab?

  // MUHOKAMA (FORUM)
  forumPosts     ForumPost[] @relation("ForumAuthor")
  forumModerated ForumPost[] @relation("ForumModerator")
  forumLikes     ForumLike[]

  // O'QITUVCHI PANELI - USTOZ SIFATIDA
  teacherStudents TeacherStudent[] @relation("TeacherStudents")
  teacherGroups   TeacherGroup[]
  assignments     Assignment[]
  announcements   Announcement[]
  createdQuizzes  TeacherQuiz[]

  // O'QITUVCHI PANELI - TALABA SIFATIDA
  studentTeachers       TeacherStudent[]       @relation("StudentTeachers")
  assignmentSubmissions AssignmentSubmission[]
  quizAttempts          TeacherQuizAttempt[]

  // MAVSUMIY HAMKORLIK SINOVLARI
  partnershipAttempts   PartnershipAttempt[]
}

// ═══════════════════════════════════════════════════════════════
// AUTH (NextAuth)
// ═══════════════════════════════════════════════════════════════

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════════════════════════════
// QUIZ VA SERTIFIKATLAR
// ═══════════════════════════════════════════════════════════════

model QuizResult {
  id             String   @id @default(cuid())
  // Bir urinishni qayta yuborish ikkinchi marta XP bermasligi uchun server
  // yaratgan yagona kalit. Eski natijalarda qiymat yo'qligi tabiiy.
  attemptId      String?  @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizName       String
  score          Int
  percentage     Float
  timeSpent      Int
  totalQuestions Int
  completedAt    DateTime @default(now())
}

// Sertifikatni FAQAT admin beradi va hamma ma'lumotni admin panelda kiritadi.
// Avval sahifada foydalanuvchining o'zi ism va ball yozib PDF yasay olardi —
// u bazaga umuman yozilmasdi, ya'ni sertifikat hech narsani tasdiqlamasdi.
model Certificate {
  id     String @id @default(cuid())
  certId String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ─── Sertifikatda chop etiladigan ma'lumot ───
  // Ism-familya sertifikatning o'zida saqlanadi, User.fullName'dan olinmaydi:
  // profilda taxallus yozilgan bo'lishi mumkin, sertifikatda esa rasmiy ism
  // turishi shart. Profil keyin o'zgarsa ham berilgan sertifikat o'zgarmaydi.
  fullName    String
  fan         String // qaysi fan uchun berilgan (hozircha matn, keyin Fan modeliga bog'lanadi)
  reason      String // nima uchun berilgan
  description String? @db.Text
  seals       Json? // pechatlar: [{url, label}]

  // ─── Kim berdi ───
  // Reaksiya tasdig'idagi naqsh: admin o'chirilsa bog'lanish uziladi,
  // lekin sertifikatning o'zi va berilgan sanasi joyida qoladi.
  issuedById String?
  issuedBy   User?   @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  // ─── Baho — ixtiyoriy ───
  // Quiz asosida beriladigan sertifikat uchun. Admin qo'lda bergan
  // sertifikatda (masalan olimpiada g'olibi) ball umuman bo'lmasligi mumkin.
  examName   String?
  grade      String?
  score      Int?
  percentage Float?
  percentile Float?

  issuedAt  DateTime  @default(now())
  expiresAt DateTime? // muddatsiz sertifikat uchun bo'sh qoldiriladi
  status    String    @default("valid")

  @@index([userId])
  @@index([fan])
  @@index([issuedById])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// MAVSUMIY HAMKORLIK VA OLIMPIADA SINOVLARI
// ═══════════════════════════════════════════════════════════════
model SeasonalPartnership {
  id              String    @id @default(cuid())
  slug            String    @unique // masalan: "alchemiq" -> /hamkorlik/alchemiq
  title           String    // "1 Kunlik Sinov Testi"
  partnerName     String    // "AlchemIQ"
  partnerLogo     String?   // Logo URL yoki SVG
  partnerSignName String?   // "AlchemIQ Sardor Ergashev"
  partnerSignUrl  String?   // Imzo rasmi URL
  jdaSignName     String?   @default("JDA Kimyo Jamoasi")
  jdaSignUrl      String?   // JDA Imzo rasmi URL
  description     String?   @db.Text
  certReason      String?   @db.Text // Sertifikatdagi asosiy taqdimot matni
  certPrefix      String    @default("AK-JK-2025-")
  badgeText       String    @default("YUKORI NATIJA")
  minPassPercent  Float     @default(75.0)
  timeLimitMin    Int       @default(40) // Daqiqalarda
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean   @default(true)
  isAnnounced     Boolean   @default(false) // Admin e'lon qilmaguncha natijalar va sertifikatlar yashirin bo'ladi
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attempts        PartnershipAttempt[]

  @@index([slug])
  @@index([isActive])
  @@index([isAnnounced])
}

model PartnershipAttempt {
  id             String              @id @default(cuid())
  partnershipId  String
  partnership    SeasonalPartnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  score          Int
  percentage     Float
  totalQuestions Int
  timeSpentSec   Int                 @default(0)
  passed         Boolean             @default(false)
  certId         String?             @unique
  completedAt    DateTime            @default(now())

  @@unique([partnershipId, userId]) // Har bir profil faqat 1 marta ishlay oladi
  @@index([partnershipId])
  @@index([userId])
  @@index([score])
  @@index([completedAt])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  category    String
  question    String   @db.Text
  options     Json
  correct     Int
  explanation String?  @db.Text
  difficulty  String   @default("o'rta")
  tags        Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([difficulty])
}

// ═══════════════════════════════════════════════════════════════
// DO'STLIK VA IJTIMOIY
// ═══════════════════════════════════════════════════════════════

model Friendship {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  user1     User     @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  sender     User     @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  message    String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@unique([senderId, receiverId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

// ═══════════════════════════════════════════════════════════════
// GAMIFICATION
// ═══════════════════════════════════════════════════════════════

model Achievement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String
  name           String
  description    String
  icon           String
  rarity         String
  earnedAt       DateTime @default(now())

  @@unique([userId, achievementKey])
}

model AchievementDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @db.Text
  icon        String   @default("🏆")
  rarity      String   @default("common")
  category    String   @default("general")
  requirement String?  @db.Text
  xpReward    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([rarity])
  @@index([isActive])
}

model Mission {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  type        String
  title       String
  description String
  xpReward    Int
  icon        String
  difficulty  String   @default("easy")
  createdAt   DateTime @default(now())

  completions MissionCompletion[]

  @@unique([date, type])
}

model MissionCompletion {
  id          String   @id @default(cuid())
  userId      String
  missionId   String
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
}

model DailyActivity {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date
  quizCount     Int      @default(0)
  videoCount    Int      @default(0)
  compoundCount Int      @default(0)
  missionCount  Int      @default(0)
  totalXP       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ═══════════════════════════════════════════════════════════════
// KIMYO MAZMUNI
// ═══════════════════════════════════════════════════════════════

model Compound {
  id                 String   @id @default(cuid())
  formula            String
  name               String
  centralAtom        String
  ligands            String
  coordinationNumber Int
  geometry           String
  oxidationState     Int
  color              String?
  category           String
  description        String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  molecule3D Molecule3D?
}

model Molecule3D {
  id                 String  @id @default(cuid())
  name               String
  formula            String
  smiles             String?
  molData            String  @db.Text
  pdbData            String? @db.Text
  category           String
  centralAtom        String
  ligands            String
  coordinationNumber Int
  geometry           String
  description        String? @db.Text
  color              String  @default("blue")
  isFeatured         Boolean @default(false)
  isActive           Boolean @default(true)

  compoundId String?   @unique
  compound   Compound? @relation(fields: [compoundId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([centralAtom])
  @@index([isFeatured])
}

// ═══════════════════════════════════════════════════════════════
// MUHOKAMA (FORUM)
// ═══════════════════════════════════════════════════════════════
//
// Ikki xil ishlatiladi:
//   • articleId = null  -> umumiy lenta (dolzarb kimyoviy mavzular)
//   • articleId = "3"   -> shu maqola ostidagi muhokama
//
// Maqolalar hozircha public/data/maqolalar.json faylida saqlangani uchun
// articleId tashqi kalit emas, oddiy matn. Maqolalar bazaga ko'chirilsa,
// id'lar shu holicha mos keladi.

model ForumPost {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation("ForumAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  articleId String? // null = umumiy lenta
  title     String? // faqat yangi mavzu ochilganda (javoblarda bo'sh)
  content   String  @db.Text

  // Javob zanjiri
  parentId String?
  parent   ForumPost?  @relation("ForumReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ForumPost[] @relation("ForumReplies")

  // Moderatsiya — post admin tasdiqlagandan keyin ko'rinadi
  status        String    @default("pending") // pending | approved | rejected
  moderatedById String?
  moderatedBy   User?     @relation("ForumModerator", fields: [moderatedById], references: [id])
  moderatedAt   DateTime?
  rejectReason  String?   @db.Text

  isPinned Boolean     @default(false)
  likes    ForumLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([articleId])
  @@index([parentId])
  @@index([createdAt])
}

model ForumLike {
  id     String @id @default(cuid())
  postId String
  userId String

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// ═══════════════════════════════════════════════════════════════
// KIMYOVIY REAKSIYALAR
// ═══════════════════════════════════════════════════════════════

model Reaction {
  id String @id @default(cuid())

  // ─── Asosiy ───
  equation     String  @db.Text // "H₂SO₄ + 2NaOH → Na₂SO₄ + 2H₂O"
  name         String? // "Sulfat kislotaning neytrallanishi"
  description  String? @db.Text
  category     String // Asid-baza, Redoks, Sintez, Parchalanish...
  reactionType String? // neytrallanish, almashinish, qo'shilish...

  // ─── Qidiruv indeksi ───
  // lib/chem-search.js to'ldiradi. Formuladagi pastki indekslar oddiy
  // raqamga aylantiriladi, shunda "H2SO4" deb qidirilsa ham "H₂SO₄" topiladi.
  searchText    String @db.Text
  searchCompact String @db.Text

  // ─── Borish sharoiti ───
  temperature String? // "25°C", "400-500°C"
  pressure    String? // "1 atm", "150-300 atm"
  catalyst    String? // "V₂O₅", "Fe", "Yo'q"
  environment String? // "kislotali muhit", "inert atmosfera"

  // ─── Mexanizm va oraliq moddalar ───
  mechanism     String? @db.Text
  intermediates Json? // [{formula, name, note}]

  // ─── Erituvchi ───
  solvents      Json? // [{name, efficiency, note}] — samaradorlik solishtiruvi
  bestSolvent   String? // eng samarali erituvchi
  solventEffect String? @db.Text // erituvchi reaksiyaga qanday ta'sir qiladi

  // ─── Qo'llanilish ko'lami ───
  scale     String? // laboratoriya | sanoat | ikkalasi | nazariy
  scaleNote String? @db.Text

  // ─── Tezlikni oshirish omillari ───
  rateFactors Json? // [{factor, effect}]

  // ─── Amaliy tomoni ───
  techniques   Json? // ["Qaytar sovutgich", "Distillash", "Filtrlash"]
  equipment    Json? // kerakli asbob-uskunalar
  hazards      Json? // xavfsizlik ogohlantirishlari
  observations String? @db.Text // rang o'zgarishi, gaz ajralishi, cho'kma
  yieldInfo    String? // unum haqida

  // ─── Manba va ishonchlilik ───
  source    String? // ma'lumot manbasi (atribut uchun)
  sourceUrl String?

  // ─── Tasdiqlash ───
  // Kimyogar ko'rib chiqib tasdiqlaganmi. Import qilingan ma'lumot
  // avtomatik ravishda false bo'ladi — talabaga tekshirilmagan deb ko'rsatiladi.
  //
  // "Kim tasdiqladi" saqlanishi shart: tasdiq javobgarlik bilan keladi.
  // Foydalanuvchi o'chirilsa bog'lanish uziladi, lekin tasdiq sanasi qoladi.
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("ReactionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([scale])
  @@index([isActive])
  @@index([isVerified])
  @@index([verifiedById])
}

model AnalysisMethod {
  id            String   @id @default(cuid())
  name          String
  nameUz        String
  nameEn        String?
  category      String
  description   String   @db.Text
  application   String?  @db.Text
  advantages    String?  @db.Text
  disadvantages String?  @db.Text
  accuracy      String?
  cost          String?
  time          String?
  icon          String   @default("🔬")
  color         String   @default("blue")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════════
// MODERATION VA ADMIN
// ═══════════════════════════════════════════════════════════════

model Report {
  id         String    @id @default(cuid())
  reporterId String
  targetId   String
  targetType String
  reason     String    @db.Text
  category   String    @default("spam")
  status     String    @default("pending")
  priority   String    @default("medium")
  reviewedBy String?
  reviewedAt DateTime?
  resolution String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id])
  target   User @relation("ReportTarget", fields: [targetId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// LABORATORIYA
// ═══════════════════════════════════════════════════════════════

// Laboratoriya katalogi: reagentlar, jihozlar va texnikalar.
//
// Manbasi — data/laboratoriya/ dagi fayllar, ular seed skript bilan shu
// yerga ko'chiriladi (data/reactions → Reaction bilan bir xil naqsh).
//
// Reagentlar reaksiyalar bazasidan generatsiya qilinadi: nodirlik va narx
// modda nechta reaksiyada uchrashidan chiqadi. Ya'ni o'yin iqtisodiyoti
// o'ylab topilmagan, kimyoning o'zidan kelib chiqqan.
model LabItemDef {
  id     String  @id @default(cuid())
  kalit  String  @unique // "H₂O", "probirka", "titrlash"
  nom    String
  turi   String // "reagent" | "jihoz" | "texnika"
  guruh  String? // jihoz uchun: shisha, isitish, olchov, himoya, sanoat...
  icon   String?
  tavsif String? @db.Text

  // ─── Nodirlik va narx ───
  nodirlik    String @default("oddiy") // oddiy | kam | nodir | noyob
  uchraydi    Int    @default(0) // nechta reaksiyada reagent — nodirlik shundan
  chiqadi     Int    @default(0) // nechta reaksiyada mahsulot (tajribada olinadi)
  narx        Int    @default(0) // coins; 0 — sotilmaydi, faqat tajribada yasaladi
  sotishNarxi Int    @default(0) // coins; xarid narxidan past
  gemsNarxi   Int? // to'g'ridan-to'g'ri olmos xaridi (sandiqqa muqobil yo'l)

  // ─── O'lchov ───
  //
  // "ml" | "gr" | "dona". Qiymat o'ylab topilmaydi — `lib/lab-birlik.js`
  // uni moddaning agregat holatidan (lib/lab-modda.js) chiqaradi va
  // generator shu yerga yozadi. Jihoz va texnika har doim "dona".
  //
  // Nega bazada saqlanadi, har safar hisoblanmaydi: tajriba dvigateli
  // katalogni allaqachon keshlab o'qiydi, birlik esa har bir sarflashda
  // kerak. 242 moddalik jadvalni server ish vaqtida qayta-qayta
  // titkilashning ma'nosi yo'q.
  birlik String @default("dona")

  // ─── Variant ───
  //
  // `asos` — shu yozuv boshqa moddaning turi bo'lsa, o'sha moddaning
  // kaliti. Jo'mrak suvi ("H₂O-oddiy") inventarda alohida yozuv, lekin
  // reaksiya qidirishda "H₂O" ga aylanadi.
  //
  // Nega kerak: reaksiya REAGENTLAR TO'PLAMI bo'yicha topiladi
  // (lib/lab-tenglama.js). Variant o'z kaliti bilan qidirilsa, u bilan
  // birorta ham reaksiya mos kelmasdi. Mexanizm suvga xos emas —
  // suyultirilgan va konsentrlangan kislota ham shu yo'l bilan qo'shiladi.
  asos String?

  // Tugamaydigan manba (jo'mrak suvi). Bunday buyum inventarda yozuv
  // ochmaydi: sarflansa kamaymaydi, "yetarlimi" tekshiruvi esa doim
  // ijobiy. Aks holda foydalanuvchi bepul suvni ham "sotib olishi"
  // kerak bo'lardi va bu bepul degani bo'lmasdi.
  cheksiz Boolean @default(false)

  // Shartli cheksizlik: shu KALITGA ega foydalanuvchi uchun bu buyum
  // tugamaydigan manbaga aylanadi. Distillagich (haydash apparati)
  // o'rnatgan odam distillangan suvni boshqa sotib olmaydi — u uni
  // o'zi yasaydi.
  //
  // Nega alohida ustun, `cheksiz` ga bayroq emas: cheksizlik
  // FOYDALANUVCHIGA bog'liq, katalogga emas. Bir xil yozuv bir odam
  // uchun cheksiz, boshqasi uchun sotib olinadigan bo'lishi mumkin.
  cheksizAgar String?

  // ─── Idish xossalari ───
  //
  // `sigim` — nechа ml sig'adi. Noldan katta bo'lsa bu IDISH, ya'ni unga
  // quyish mumkin va sig'imidan ortiq quyib bo'lmaydi. Shtativ va
  // termometr uchun nol.
  //
  // `material` — shisha | chinni | kvarts | metall | qogoz. Reaksiya
  // idishni yaroqsiz qiladimi shu bilan hal bo'ladi: ftorid kislota
  // shishani eritadi, 500 °C dan yuqori harorat uni yumshatadi.
  //
  // Qiymatlar `lib/lab-idish.js` dan keladi. Ilgari sig'im faqat 3D
  // modellarida edi va serverdan o'qib bo'lmasdi — ya'ni "idishga
  // sig'maydi" degan tekshiruv umuman yo'q edi.
  sigim    Float   @default(0)
  material String?

  // ─── Xossalar ───
  sarflanadi Boolean @default(false) // ishlatilganda yo'qoladi (filtr qog'ozi)
  sanoat     Boolean @default(false) // talaba laboratoriyasida bo'lmaydi
  daraja     Int     @default(1) // ochilishi uchun kerakli laboratoriya darajasi

  // Reaksiyalarni katalogga bog'lash uchun: bazadagi xom equipment/techniques
  // qiymatlari (bir jihozning bir necha nomi bo'lishi mumkin).
  xom     Json?
  oilalar Json? // reagent qaysi reaksiya oilalarida uchraydi

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventarda LabItem[]

  @@index([turi])
  @@index([nodirlik])
  @@index([guruh])
  @@index([isActive])
}

// Foydalanuvchining laboratoriyasi. Bo'sh boshlanadi — jihozlar sotib
// olinadi, reagentlar sandiqdan yoki do'kondan keladi.
model Lab {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nom String @default("Mening laboratoriyam")

  // `tajriba` — asosiy son, `daraja` esa undan hisoblanadi (lib/tajriba.js).
  // Daraja shu yerda ham saqlanadi, chunki u xarid va texnika darvozasida
  // tekshiriladi: har safar qayta hisoblash o'rniga bir joyda — tajriba
  // o'tkazilganda — yangilanadi.
  daraja  Int @default(1)
  tajriba Int @default(0) // laboratoriya XP — tajriba o'tkazgan sari o'sadi

  // Kunlik sandiq oxirgi marta qachon olingani. Kun chegarasi UTC yarim
  // tuni — kunlik missiyalar bilan bir xil, aks holda "bugun" ikki xil
  // ma'noda ishlatilardi.
  oxirgiKunlikSandiq DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        LabItem[]
  transactions LabTransaction[]
  experiments  LabExperiment[]
}

// O'tkazilgan tajribalar jurnali.
//
// Nega saqlanadi: "shu reaksiyani birinchi marta qilyapsanmi" degan savolga
// javob shu yerdan chiqadi — kashfiyot mukofoti aynan shunga bog'liq. Undan
// tashqari bu foydalanuvchining laboratoriya daftari: nimani qachon olgani
// ko'rinib turadi.
//
// `reactionId` ataylab oddiy matn, bog'lanish emas: reaksiya bazadan
// o'chirilsa ham daftardagi yozuv qolishi kerak. Shu sababli tenglama ham
// nusxa qilib saqlanadi — o'sha kungi ko'rinishi bilan.
model LabExperiment {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  reactionId String
  equation   String @db.Text

  tajriba  Int     @default(0) // shu tajriba uchun berilgan XP
  birinchi Boolean @default(false) // shu reaksiya ilk marta o'tkazildimi

  createdAt DateTime @default(now())

  @@index([labId])
  @@index([labId, reactionId])
  @@index([createdAt])
}

// Inventar: kim nimaga ega va nechta.
//
// `kalit` LabItemDef ga bog'langan. Katalogdan chiqarilgan yozuv
// o'chirilmaydi (isActive=false bo'ladi), shuning uchun inventar hech
// qachon "yo'q narsaga" ishora qilib qolmaydi.
model LabItem {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  kalit String
  def   LabItemDef @relation(fields: [kalit], references: [kalit], onDelete: Restrict)

  // `soni` — DONA hisobidagi eski maydon. `miqdor` — haqiqiy o'lchov
  // (ml yoki gramm), birligi LabItemDef.birlik da.
  //
  // Ikkalasi ATAYLAB birga turadi. Miqdorga o'tish bir necha bosqichda
  // boradi (sxema → server mantig'i → interfeys) va oraliq holatda eski
  // kod ishlab turishi kerak: `soni` ni darrov o'chirsak, migratsiya
  // qo'llangan zahoti do'kon ham, tajriba ham yiqilardi. `soni` faqat
  // hamma joy `miqdor` ga o'tgach olib tashlanadi.
  soni   Int   @default(1)
  miqdor Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([labId, kalit])
  @@index([labId])
  @@index([kalit])
}

// Tanga va olmos harakati.
//
// Balansning o'zi yetarli emas: nimadir noto'g'ri ketsa yoki kimdir
// aldashga urinsa, "qayerdan keldi va qayerga ketdi" degan savolga
// javob shu jadvaldan chiqadi.
model LabTransaction {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id], onDelete: Cascade)

  turi      String // "xarid" | "sotish" | "sandiq" | "mukofot"
  valyuta   String // "coins" | "gems"
  miqdor    Int // musbat — kelgan, manfiy — ketgan
  kalit     String? // qaysi buyum bilan bog'liq
  soni      Int? // nechta dona
  izoh      String?
  createdAt DateTime @default(now())

  @@index([labId])
  @@index([turi])
  @@index([createdAt])
}

// Foydalanuvchiga yuboriladigan bildirishnoma.
//
// Nega kerak: admin hisobga tegsa (tanga berdi, xarid taqiqini qo'ydi,
// rolni o'zgartirdi) foydalanuvchi buni hech qayerdan bilmasdi — balansi
// o'zgarganini keyingi kirganida ko'rardi va sababini tushunmasdi.
// AuditLog bor, lekin u ADMIN uchun: javobgarlik qaydnomasi. Bu esa
// foydalanuvchi uchun.
//
// `adminId` — kim qilgani. Admin hisobi o'chirilsa bog'lanish uziladi,
// lekin xabarning o'zi qoladi: foydalanuvchi nima bo'lganini bilishi
// kerak, kim qilgani keyin ma'lum bo'lmasa ham.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  turi     String // tanga | olmos | taqiq | taqiq-olindi | rol | blok | sertifikat | dost | tizim
  sarlavha String
  matn     String? @db.Text
  havola   String? // bosilganda qayerga o'tadi
  icon     String?

  oqilgan     Boolean   @default(false)
  oqilganVaqt DateTime?

  adminId String?
  admin   User?   @relation("NotificationAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, oqilgan])
  @@index([userId, createdAt])
  @@index([adminId])
}

// ═══════════════════════════════════════════════════════════════
// SHAXSIY CHAT
// ═══════════════════════════════════════════════════════════════

// Ikki kishi orasidagi suhbat.
//
// `holat` Instagram naqshi bo'yicha:
//   faol   — yozishmoqda (do'stlar orasida darhol shunday bo'ladi)
//   sorov  — do'st bo'lmagan odam yozdi, qabul qiluvchi hali javob
//            bermagan. Xabarlar yoziladi, lekin "so'rovlar" bo'limida
//            turadi va bildirishnoma yuborilmaydi.
//   rad    — so'rov rad etilgan; yangi xabar qabul qilinmaydi
//
// `user1Id`/`user2Id` HAR DOIM saralangan tartibda saqlanadi. Shunda
// bitta juftlik uchun ikkita suhbat paydo bo'lishi mumkin emas — bu
// xatoni keyin tuzatib bo'lmaydi, chunki yozishma ikkiga bo'linib
// ketadi.
model Conversation {
  id      String @id @default(cuid())
  user1Id String
  user2Id String
  user1   User   @relation("Suhbat1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2   User   @relation("Suhbat2", fields: [user2Id], references: [id], onDelete: Cascade)

  holat        String @default("faol") // faol | sorov | rad
  boshlovchiId String // so'rovni kim boshlagani

  oxirgiXabar DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  xabarlar Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id, oxirgiXabar])
  @@index([user2Id, oxirgiXabar])
}

// Xabar.
//
// O'chirish YUMSHOQ: matn bazada qoladi, foydalanuvchiga "o'chirildi" deb
// ko'rsatiladi. Nega: o'chirilgan xabar ustidan shikoyat kelishi mumkin va
// o'sha paytda admin nima yozilganini ko'ra olishi kerak. Aks holda
// haqorat yozib, darhol o'chirib qo'yish jazosiz qolardi.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("XabarYuboruvchi", fields: [senderId], references: [id], onDelete: Cascade)

  matn String @db.Text

  oqilgan    Boolean @default(false)
  ochirilgan Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// Bloklash.
//
// Bloklangan odam yoza olmaydi VA bloklovchining profilini ko'ra olmaydi
// (u uchun foydalanuvchi "topilmadi" bo'lib qoladi). Bloklashni faqat
// bloklovchining o'zi olib tashlaydi.
model UserBlock {
  id        String @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User   @relation("Bloklovchi", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User   @relation("Bloklangan", fields: [blockedId], references: [id], onDelete: Cascade)

  sabab     String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Chat shikoyati.
//
// Alohida jadval, chunki adminga XABARLAR kerak: shikoyat qilingan
// odamning o'sha suhbatdagi yozganlari. Umumiy Report modeli faqat
// foydalanuvchiga ishora qiladi va suhbatni topib bo'lmasdi.
model ChatReport {
  id             String @id @default(cuid())
  reporterId     String
  reportedId     String
  conversationId String

  reporter User @relation("ShikoyatYuboruvchi", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ShikoyatQilingan", fields: [reportedId], references: [id], onDelete: Cascade)

  sabab String @db.Text
  holat String @default("yangi") // yangi | korildi | chora | rad

  korganAdminId String?
  korilganVaqt  DateTime?
  adminIzohi    String?

  createdAt DateTime @default(now())

  @@index([holat, createdAt])
  @@index([reportedId])
}

// Profil posti — foydalanuvchi o'z sahifasiga qoldiradigan qisqa yozuv.
//
// Obunachilar tizimi aynan shu uchun bor edi: obuna bo'lish mumkin edi-yu,
// obuna bo'lgandan keyin hech narsa kelmasdi. Endi post yozilganda
// obunachilarga bildirishnoma boradi.
//
// Faqat MATN: rasm va havola qo'shilsa, moderatsiya va spam masalasi
// paydo bo'ladi. Kanal lentasidan farqi ham shu — kanal hamkorga
// beriladi va u nazorat ostida, profil posti esa hammada bor.
model ProfilePost {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matn String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// KANALLAR (hamkorlar dashboardi)
// ═══════════════════════════════════════════════════════════════

// Hamkor kanali — Telegram kanalining sayt ichidagi o'rnini bosadi.
//
// Farqi: obunachi bu yerda quiz yechadi, video darslikni ko'radi va
// kimyo muhitida tanilib boradi. Telegram'da kanal ochgan odam uni
// reklama qilishi kerak, bu yerda esa ochiq kanal katalogda va
// tavsiyalarda o'zi chiqadi.
//
// Kanalni FAQAT superadmin ochadi va egasini tayinlaydi. Hamkor uni
// to'ldiradi va yuritadi — shu bilan "hamkor" unvoni haqiqiy ma'noga
// ega bo'ladi va kanal nazorati saytda qoladi.
model Channel {
  id     String  @id @default(cuid())
  slug   String  @unique // manzilda ko'rinadi: /kanallar/tushunarli-kimyo
  nom    String
  tavsif String? @db.Text
  avatar String?
  banner String?
  turi   String  @default("talim") // talim | ilmiy | amaliy

  // `ochiq` — katalogda va tavsiyalarda ko'rinadimi. Yopiq kanal
  // ishlayveradi, faqat uni havola orqali topish mumkin.
  ochiq     Boolean @default(true)
  tavsiyada Boolean @default(false)
  faol      Boolean @default(true)

  egaId String
  ega   User   @relation("ChannelOwner", fields: [egaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postlar  ChannelPost[]
  videolar ChannelVideo[]
  obunalar ChannelSubscription[]

  @@index([ochiq, faol])
  @@index([egaId])
  @@index([tavsiyada])
}

// Kanal lentasi — matn va rasm bilan e'lon.
model ChannelPost {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  sarlavha String
  matn     String  @db.Text
  rasm     String?

  nashr     Boolean @default(true) // qoralama bo'lsa false
  korishlar Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId, createdAt])
}

// Kanal video darsligi. Fayl saqlanmaydi — tashqi havola (YouTube va
// hokazo) yoziladi: video hosting alohida katta ish va uni sayt o'z
// zimmasiga olishi shart emas.
model ChannelVideo {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  sarlavha  String
  tavsif    String? @db.Text
  videoUrl  String
  thumbnail String?

  tartib    Int     @default(0)
  nashr     Boolean @default(true)
  korishlar Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId, tartib])
}

model ChannelSubscription {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  details    String?  @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model SiteSettings {
  id                 String   @id @default("main")
  siteName           String   @default("JDA KIMYO")
  siteDescription    String   @default("Koordinatsion kimyo platformasi")
  logo               String?
  favicon            String?
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?  @db.Text
  footerText         String?  @db.Text
  contactEmail       String?
  contactPhone       String?
  telegramGroup      String?
  instagramLink      String?
  defaultXpCommon    Int      @default(10)
  defaultXpRare      Int      @default(50)
  defaultXpEpic      Int      @default(100)
  defaultXpLegendary Int      @default(500)
  questionsPerQuiz   Int      @default(20)
  quizTimeLimit      Int?
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

